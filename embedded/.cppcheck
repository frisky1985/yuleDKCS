# ============================================================================
# yuleDKCS Embedded C — MISRA C:2023 cppcheck Baseline Configuration
# ============================================================================
# Purpose: Quality gate — catch NEW MISRA violations only.
# Existing violations are listed under --suppress as baseline.
#
# NOTE: This file is consumed via `cppcheck --suppressions-list=embedded/.cppcheck`.
# It must contain ONLY `--suppress=` entries and comments.
# Compiler options (--std, --language, --enable, --addon, -I, -D) belong in the
# CI workflow's cppcheck invocation, NOT here — cppcheck rejects them here
# with "Failed to add suppression. Invalid id".
# ============================================================================

# ---- Rule: Dir-4.12 (Dynamic memory allocation) ---------------------------
# Approved for cache module (bounded pool allocator with OOM fallback).
# Approved for unit test support files.
misra-c2012-dir-4.12:embedded/icce_protocol/src/cache/cache_manager.c
misra-c2012-dir-4.12:embedded/icce_protocol/src/decision/offline_decision.c
misra-c2012-dir-4.12:embedded/tests/support/stubs.c

# ---- Rule: 2.5 (Macro used with suspicious macro) -------------------------
# Accepted for test support macros (TEST_ASSERT_EQUAL, etc.)
misra-c2012-2.5:embedded/tests/*

# ---- Rule: 8.7 (Function not called locally) ------------------------------
# All public API functions are called across files; cppcheck cannot
# follow cross-file call chains. Suppress globally for API headers.
misra-c2012-8.7:embedded/icce_protocol/include/*
misra-c2012-8.7:embedded/ccc_protocol/include/*
misra-c2012-8.7:embedded/iccoa_protocol/include/*
misra-c2012-8.7:embedded/unified_protocol/include/*
misra-c2012-8.7:embedded/icce_protocol/src/crypto/*
misra-c2012-8.7:embedded/icce_protocol/src/icce_edge.c
misra-c2012-8.7:embedded/icce_protocol/src/icce_zone.c

# ---- Rule: 15.6 (Single-statement if/while/for body) ----------------------
# Accepted for compact guard expressions in driver code.
misra-c2012-15.6:embedded/ccc_protocol/src/ble/ble_kw47a.c
misra-c2012-15.6:embedded/ccc_protocol/src/nfc/nfc_st25r501.c
misra-c2012-15.6:embedded/ccc_protocol/src/uwb/uwb_ncj29d6.c

# ---- Rule: 17.7 (Function may return without value) -----------------------
# Accepted for SE050 hardware abstraction stubs that must match
# vendor callback signatures.
misra-c2012-17.7:embedded/ccc_protocol/src/security/security.c
misra-c2012-17.7:embedded/ccc_protocol/src/keymgmt/key_mgmt.c

# ---- Rule: 21.21 (stdlib.h functions: malloc/free) ------------------------
# Accepted — cache module uses bounded, fallible heap allocation.
misra-c2012-21.21:embedded/icce_protocol/src/cache/cache_manager.c

# ---- Rule: 7.2 (unsigned integer literal suffix) --------------------------
# Accepted for startup assembly wrapper and bare-metal constants.
misra-c2012-7.2:embedded/icce_protocol/src/ble/*

# ---- ICCOA cross-file references (MISRA Dir-4.10, Rule-8.4) ---------------
# ICCOA references CCC logger by path; accepted for phase-2 decoupling.
misra-c2012-dir-4.10:embedded/iccoa_protocol/src/*
misra-c2012-8.4:embedded/iccoa_protocol/src/*

# ---- Unified protocol layer patterns --------------------------------------
# Uses goto for single-cleanup-path pattern; accepted per AUTOSAR C++14.
misra-c2012-15.1:embedded/unified_protocol/src/dk_unified.c

# ---- Crypto library patterns (pure computation) ---------------------------
# Loop counters, intermediate constants, and bit-manipulation patterns
# that intentionally deviate from MISRA for performance/correctness.
misra-c2012-10.1:embedded/icce_protocol/src/crypto/*
misra-c2012-10.3:embedded/icce_protocol/src/crypto/*
misra-c2012-10.4:embedded/icce_protocol/src/crypto/*
misra-c2012-10.8:embedded/icce_protocol/src/crypto/*
misra-c2012-12.1:embedded/icce_protocol/src/crypto/*
misra-c2012-14.4:embedded/icce_protocol/src/crypto/*
misra-c2012-20.7:embedded/icce_protocol/src/crypto/*

# ---- Project-wide suppressions (by pattern, not file) ---------------------
# unusedFunction checks are noisy for embedded because build targets
# are separate; limit to test files only.
unusedFunction:embedded/tests/*

# Dollar-in-identifier ($) — generated CMSIS headers
dollarInStringLiteral:embedded/*/build/*

